font=SF Pro Text 10

anchor=top-right
width=360
height=160
margin=16
padding=14,18

border-radius=12
border-size=1

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#313244
progress-color=over #31324488

icons=1
max-icon-size=48
icon-location=left

default-timeout=5000
ignore-timeout=0

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all
on-touch=invoke-default-action

[urgency=low]
border-color=#313244
default-timeout=3000

[urgency=normal]
border-color=#313244
default-timeout=5000

[urgency=high]
border-color=#f38ba8
default-timeout=0
